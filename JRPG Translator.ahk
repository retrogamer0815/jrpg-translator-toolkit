StudyLibraryManagerOpenFolder(slManager, *) {
    slName := StudyLibraryManagerSelectedName(slManager)
    slDirectory := StudyLibraryDirectoryForName(slName)
    if (slDirectory != "" && DirExist(slDirectory))
        Run('explorer.exe "' slDirectory '"')
