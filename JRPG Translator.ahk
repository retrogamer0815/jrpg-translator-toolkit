    }
    CPBigBoxControls["capture_settings"].Visible := CPBigBoxCurrentPage = "screenshot" && !choosing
    CPBigBoxControls["capture_settings"].Enabled := CPBigBoxCurrentPage = "screenshot" && !choosing
    CPBigBoxUpdateAudioPower()
