}

CPBigBoxSaveRawGlossary(*) {
    global CPBigBoxCurrentPage, CPBigBoxManageState, CPBigBoxControls, CPBigBoxManageNotice
    if CPBigBoxCurrentPage != "manageRaw" || !CPBigBoxManageState["active"]
        return
    state := CPBigBoxManageState
