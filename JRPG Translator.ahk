    slState := slArchive["ownerState"]
    StudyLibraryRefreshLibrarySelector(slState)
    StudyLibraryRefreshManager(slManager, slName)
    StudyLibraryRefreshArchives(slArchive)
    StudyLibraryManagementClose(slDialog)
