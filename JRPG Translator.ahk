        "returnKey", returnKey, "provider", "", "profile", "")
    CPBigBoxStopPageAnimation()
    CPBigBoxDashboardRelayoutAndUpdate()
    CPBigBoxApplyPageVisibility()
    CPBigBoxFocusAIChoice()
    return true
}

