            : [hkBtnChg[action], hkBtnDis[action], hkBtnDef[action]]
        CPDesktopPlace(actionLabel, x, y, stacked ? cw : actionW - 12, 28)
        rowY := stacked ? y + 30 : y, editX := stacked ? x : x + actionW
