            slSavedW := slDefaultW
        try slSavedH := Integer(slSavedH)
        catch
            slSavedH := slDefaultH
        slSavedW := Max(slState.Has("desktop") ? 960 : 640, Min(slMaxW, slSavedW))
        slSavedH := Max(slState.Has("desktop") ? 700 : 440, Min(slMaxH, slSavedH))
        slGui.Show("Hide w" slSavedW " h" slSavedH)
