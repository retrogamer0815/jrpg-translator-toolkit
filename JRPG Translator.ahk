CPBigBoxPromptEditorActive(*) {
    global CPBigBoxCurrentPage, CPBigBoxSetupState, CPBigBoxGui, CPBigBoxControls
    if !CPBigBoxDashboardAlive() || CPBigBoxCurrentPage != "setupEdit"
        || CPBigBoxSetupState.Get("flow", "") != "promptText"
        return false
    focused := 0
    try focused := CPBigBoxGui.FocusedCtrl
    return IsObject(focused) && CPBigBoxControls.Has("setup_raw")
        && focused.Hwnd = CPBigBoxControls["setup_raw"].Hwnd
}

CPBigBoxPreparePromptEditor(*) {
    global CPBigBoxCurrentPage, CPBigBoxSetupState, CPBigBoxControls
    if !CPBigBoxDashboardAlive() || CPBigBoxCurrentPage != "setupEdit"
        || CPBigBoxSetupState.Get("flow", "") != "promptText"
        return
    editor := CPBigBoxControls["setup_raw"]
    index := CPBigBoxDashboardControlIndex(editor)
    if index
        CPBigBoxDashboardSetFocus(index)
    else
        try editor.Focus()
    ; Native multiline Edit controls select their complete contents when they
    ; first receive focus. Keep the prompt visible from the top and ready for
    ; normal keyboard editing with a simple, unselected caret instead.
    try SendMessage(0x00B1, 0, 0, editor.Hwnd) ; EM_SETSEL
    try SendMessage(0x00B7, 0, 0, editor.Hwnd) ; EM_SCROLLCARET
}

CPBigBoxResetSetup(*) {
    global CPBigBoxSetupState, CPBigBoxSetupNotice
    CPBigBoxSetupState := Map("active", false)
    CPBigBoxSetupNotice := ""
}

CPBigBoxApiKeyNames(provider) {
    return provider = "gemini"
        ? ["GEMINI_API_KEY", "GOOGLE_API_KEY"] : ["OPENAI_API_KEY"]
}

CPBigBoxApiLocalValue(provider) {
    global envPath
    if !FileExist(envPath)
        return ""
    body := ""
    try body := FileRead(envPath, "UTF-8")
    for keyName in CPBigBoxApiKeyNames(provider) {
        value := CPDotEnvValue(body, keyName)
        if value != ""
            return value
    }
    return ""
}

CPBigBoxApiWindowsConfigured(provider) {
    names := provider = "gemini"
        ? ["GEMINI_API_KEY", "GOOGLE_API_KEY", "GEMINI_LOCAL_KEY", "GOOGLE_LOCAL_KEY"]
        : ["OPENAI_API_KEY", "OPENAI_LOCAL_KEY", "OPENAI_API_KEY_LOCAL", "OPENAI_KEY"]
    for name in names
        if CPNormalizeApiSecret(EnvGet(name)) != ""
            return true
    return false
}

CPBigBoxApiStatus(provider) {
    windows := CPBigBoxApiWindowsConfigured(provider)
    inApp := CPBigBoxApiLocalValue(provider) != ""
    if windows && inApp
        return "Configured · Windows + in-app"
    if windows
        return "Configured · Windows"
    if inApp
        return "Configured · in-app"
    return "Not configured"
}

CPBigBoxBuildEnvBody(provider, value) {
    global envPath
    body := ""
    if FileExist(envPath)
        try body := FileRead(envPath, "UTF-8")
    skip := Map()
    for keyName in CPBigBoxApiKeyNames(provider)
        skip[StrUpper(keyName)] := true
    kept := []
    for rawLine in StrSplit(body, "`n", "`r") {
        line := StrReplace(rawLine, Chr(0xFEFF), "")
        if RegExMatch(line, "^\s*([A-Za-z_][A-Za-z0-9_]*)\s*=", &match)
            if skip.Has(StrUpper(match[1]))
                continue
        if line != ""
            kept.Push(line)
    }
    value := CPNormalizeApiSecret(value)
    if value != "" {
        if provider = "gemini" {
            kept.Push("GOOGLE_API_KEY=" value)
            kept.Push("GEMINI_API_KEY=" value)
        } else {
            kept.Push("OPENAI_API_KEY=" value)
        }
    }
    result := ""
    for line in kept
        result .= line "`r`n"
    return result
}

