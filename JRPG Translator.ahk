; ===================== Direct controller inputs =====================
CPControllerTokenDisplay(token) {
    static labels := Map(
        "X:DPAD_UP", "D-pad Up", "X:DPAD_DOWN", "D-pad Down",
        "X:DPAD_LEFT", "D-pad Left", "X:DPAD_RIGHT", "D-pad Right",
        "X:START", "Menu / Start", "X:BACK", "View / Back",
        "X:LS", "Left stick click", "X:RS", "Right stick click",
        "X:LB", "Left shoulder", "X:RB", "Right shoulder",
        "X:A", "A / Cross", "X:B", "B / Circle",
        "X:X", "X / Square", "X:Y", "Y / Triangle",
        "X:LT", "Left trigger", "X:RT", "Right trigger"
    )
    if labels.Has(token)
        return labels[token]
    if InStr(token, "J:") = 1
        return SubStr(token, 3)
    return token
}

CPJoystickNativeCapabilities(controllerId, forget := false) {
    ; AutoHotkey's legacy joystick lookups can enter unstable driver code when
    ; a device disappears between enumeration and a state query. Read and cache
    ; both the device name and its native axis ranges through WinMM instead.
    static cachedCapabilities := Map()
    controllerId := Integer(controllerId)
    if forget {
        if cachedCapabilities.Has(controllerId)
            cachedCapabilities.Delete(controllerId)
        return false
    }
    if cachedCapabilities.Has(controllerId)
        return cachedCapabilities[controllerId]

    ; JOYCAPSW is 728 bytes: two WORDs, a 32-character product name,
    ; 19 UINT capability fields, a 32-character registry key, and a
    ; 260-character OEM driver name.  szPname begins at byte offset 4.
    caps := Buffer(728, 0)
    result := 1
    try result := DllCall("winmm\joyGetDevCapsW"
        , "uptr", controllerId - 1, "ptr", caps.Ptr, "uint", caps.Size, "uint")
    if (result != 0)
        return false

    controllerName := ""
    try controllerName := Trim(StrGet(caps.Ptr + 4, 32, "UTF-16"))
    if (controllerName = "")
        controllerName := "Joystick " controllerId

    axisRanges := Map(
        "X", [NumGet(caps, 68, "uint"), NumGet(caps, 72, "uint")],
        "Y", [NumGet(caps, 76, "uint"), NumGet(caps, 80, "uint")],
        "Z", [NumGet(caps, 84, "uint"), NumGet(caps, 88, "uint")],
        "R", [NumGet(caps, 104, "uint"), NumGet(caps, 108, "uint")],
        "U", [NumGet(caps, 112, "uint"), NumGet(caps, 116, "uint")],
        "V", [NumGet(caps, 120, "uint"), NumGet(caps, 124, "uint")]
    )
    capabilities := Map("name", controllerName, "axisRanges", axisRanges)
    cachedCapabilities[controllerId] := capabilities
    return capabilities
}

CPJoystickNativeName(controllerId, forget := false) {
    capabilities := CPJoystickNativeCapabilities(controllerId, forget)
    if !IsObject(capabilities)
        return forget ? "" : "Joystick " Integer(controllerId)
    return capabilities["name"]
}

CPJoystickNativeAxisRanges(controllerId) {
    capabilities := CPJoystickNativeCapabilities(controllerId)
    return IsObject(capabilities) ? capabilities["axisRanges"] : false
}

CPJoystickNativeSnapshot(controllerId) {
    ; One joyGetPosEx call returns all 32 buttons and the POV hat together.
    ; This avoids repeatedly crossing AutoHotkey's legacy GetKeyState joystick
    ; path (previously up to 34 calls per device on every 20 ms timer tick).
    static JOY_RETURNALL := 0xFF
    stateBuffer := Buffer(52, 0) ; JOYINFOEX: thirteen DWORD values.
    NumPut("uint", stateBuffer.Size, stateBuffer, 0)
    NumPut("uint", JOY_RETURNALL, stateBuffer, 4)
    result := 1
    try result := DllCall("winmm\joyGetPosEx"
        , "uint", Integer(controllerId) - 1, "ptr", stateBuffer.Ptr, "uint")
    if (result != 0)
        return false
    return Map(
        "axes", Map(
            "X", NumGet(stateBuffer, 8, "uint"),
            "Y", NumGet(stateBuffer, 12, "uint"),
            "Z", NumGet(stateBuffer, 16, "uint"),
            "R", NumGet(stateBuffer, 20, "uint"),
            "U", NumGet(stateBuffer, 24, "uint"),
            "V", NumGet(stateBuffer, 28, "uint")
        ),
        "buttons", NumGet(stateBuffer, 32, "uint"),
        "pov", NumGet(stateBuffer, 40, "uint")
    )
}

CPControllerAppendLegacyState(snapshot, controllerId, legacyState) {
    controllerName := CPJoystickNativeName(controllerId)
    if !snapshot["connected"] {
        snapshot["connected"] := true
        snapshot["name"] := controllerName
    }
    pressedButtons := legacyState["buttons"]
    Loop 32 {
        buttonIndex := A_Index
        if (pressedButtons & (1 << (buttonIndex - 1)))
            snapshot["tokens"]["J:Button " buttonIndex] := true
    }
    pov := legacyState["pov"]
    if (pov < 36000) {
        if (pov >= 31500 || pov <= 4500)
            snapshot["tokens"]["J:D-pad Up"] := true
        if (pov >= 4500 && pov <= 13500)
            snapshot["tokens"]["J:D-pad Right"] := true
        if (pov >= 13500 && pov <= 22500)
            snapshot["tokens"]["J:D-pad Down"] := true
        if (pov >= 22500 && pov <= 31500)
            snapshot["tokens"]["J:D-pad Left"] := true
    }
}

CPControllerReadSnapshot() {
    static xinputButtons := [
        [0x0001, "X:DPAD_UP"], [0x0002, "X:DPAD_DOWN"],
        [0x0004, "X:DPAD_LEFT"], [0x0008, "X:DPAD_RIGHT"],
        [0x0010, "X:START"], [0x0020, "X:BACK"],
        [0x0040, "X:LS"], [0x0080, "X:RS"],
        [0x0100, "X:LB"], [0x0200, "X:RB"],
        [0x1000, "X:A"], [0x2000, "X:B"],
        [0x4000, "X:X"], [0x8000, "X:Y"]
    ]
    ; XInput is cheap enough to check every poll.  WinMM device discovery is
    ; deliberately throttled: repeatedly probing every possible legacy slot
    ; while a controller/driver is disappearing can destabilize vendor drivers.
    static controllerBackend := ""
    static legacyControllerIds := []
    static xinputDisconnectStartedMs := 0
    static nextLegacyDiscoveryMs := 0
    static DISCONNECT_GRACE_MS := 750
    static LEGACY_DISCOVERY_INTERVAL_MS := 1000
    snapshot := Map("connected", false, "name", "", "tokens", Map())
    nowMs := DllCall("kernel32\GetTickCount64", "uint64")

    Loop 4 {
        userIndex := A_Index - 1
        state := CPXInputGetState(userIndex)
        if !IsObject(state)
            continue
        if !snapshot["connected"] {
            snapshot["connected"] := true
            snapshot["name"] := "XInput controller " A_Index
        }
        buttons := state["buttons"]
        for buttonInfo in xinputButtons {
            if (buttons & buttonInfo[1])
                snapshot["tokens"][buttonInfo[2]] := true
        }
        if (state["leftTrigger"] >= 128)
            snapshot["tokens"]["X:LT"] := true
        if (state["rightTrigger"] >= 128)
            snapshot["tokens"]["X:RT"] := true
    }
    if snapshot["connected"] {
        controllerBackend := "xinput"
        legacyControllerIds := []
        xinputDisconnectStartedMs := 0
        nextLegacyDiscoveryMs := 0
        return snapshot
    }

    ; Do not immediately reinterpret an unplugged XInput device as a legacy
    ; joystick.  Give Windows and the controller driver time to settle first;
    ; a reconnect is still noticed immediately by the XInput loop above.
    if (controllerBackend = "xinput") {
        if !xinputDisconnectStartedMs
            xinputDisconnectStartedMs := nowMs
        if ((nowMs - xinputDisconnectStartedMs) < DISCONNECT_GRACE_MS)
            return snapshot
        controllerBackend := ""
        legacyControllerIds := []
        xinputDisconnectStartedMs := 0
        nextLegacyDiscoveryMs := 0
    } else {
        xinputDisconnectStartedMs := 0
    }

    ; DualSense and other non-XInput devices are exposed through the legacy
    ; joystick API. Once found, only the known device slots are polled at the
    ; normal 20 ms rate. Button numbering follows Windows' controller panel.
    if (controllerBackend = "legacy" && legacyControllerIds.Length) {
        stillConnectedIds := []
        for controllerId in legacyControllerIds {
            legacyState := CPJoystickNativeSnapshot(controllerId)
            if !IsObject(legacyState) {
                CPJoystickNativeName(controllerId, true)
                continue
            }
            stillConnectedIds.Push(controllerId)
            CPControllerAppendLegacyState(snapshot, controllerId, legacyState)
        }
        legacyControllerIds := stillConnectedIds
        if snapshot["connected"]
            return snapshot

        ; The active legacy controller disappeared.  Reset immediately, then
        ; defer broad discovery briefly instead of hammering all driver slots.
        controllerBackend := ""
        nextLegacyDiscoveryMs := nowMs + DISCONNECT_GRACE_MS
        return snapshot
    }

    if (nowMs < nextLegacyDiscoveryMs)
        return snapshot
    nextLegacyDiscoveryMs := nowMs + LEGACY_DISCOVERY_INTERVAL_MS

    detectedLegacyIds := []
    Loop 16 {
        controllerId := A_Index
        legacyState := CPJoystickNativeSnapshot(controllerId)
        if !IsObject(legacyState) {
            CPJoystickNativeName(controllerId, true)
            continue
        }
        detectedLegacyIds.Push(controllerId)
        CPControllerAppendLegacyState(snapshot, controllerId, legacyState)
    }
    if snapshot["connected"] {
        controllerBackend := "legacy"
        legacyControllerIds := detectedLegacyIds
    }
    return snapshot
}

CPControllerUpdateStatus(snapshot := 0) {
    global txtControllerStatus, CPControllerInputsEnabled, CPControllerLastStatusText
    if !IsSet(txtControllerStatus)
        return
    if !CPControllerInputsEnabled {
        newStatus := "Bindings off; navigation remains active."
    } else {
        if !IsObject(snapshot)
            snapshot := CPControllerReadSnapshot()
        newStatus := snapshot["connected"]
            ? "Detected: " snapshot["name"]
            : "No compatible controller detected."
    }
    if (newStatus != CPControllerLastStatusText) {
        txtControllerStatus.Value := newStatus
        CPControllerLastStatusText := newStatus
    }
}

CPControllerLoadBindings() {
    global iniPath, hotkeyActions, CPControllerBindings, CPControllerBindingEdits
    CPControllerBindings := Map()
    for actionKey in hotkeyActions {
        token := Trim(IniRead(iniPath, "controller_inputs", actionKey, ""))
        CPControllerBindings[actionKey] := token
        if CPControllerBindingEdits.Has(actionKey)
            CPControllerBindingEdits[actionKey].Value := token = "" ? "Disabled" : CPControllerTokenDisplay(token)
    }
}

CPControllerSaveBinding(action, token) {
    global iniPath, CPControllerBindings, CPControllerBindingEdits
    CPControllerBindings[action] := token
    IniWrite(token, iniPath, "controller_inputs", action)
    if CPControllerBindingEdits.Has(action)
        CPControllerBindingEdits[action].Value := token = "" ? "Disabled" : CPControllerTokenDisplay(token)
}

CPControllerCaptureDialog(action) {
    global ui, hotkeyLabels, controlDarkMode, CPControllerCaptureActive
    result := ""
    closed := false
    armed := false
    dlg := Gui("+Owner" ui.Hwnd " +MinSize500x190", "Assign controller button")
    dlg.MarginX := 22, dlg.MarginY := 18
    dlg.SetFont("s10", "Segoe UI")
    dlg.BackColor := CPPalette(controlDarkMode)["window"]
    dlg.Add("Text", "xm w500", "Action: " hotkeyLabels[action])
    dlg.Add("Text", "xm y+14 w500", "Release all buttons, then press the controller button to assign.")
    status := dlg.Add("Text", "xm y+18 w500 cGray", "Waiting for a controller...")
    cancel := dlg.Add("Button", "xm y+22 w120", "Cancel")
    cancel.OnEvent("Click", (*) => (closed := true))
    dlg.OnEvent("Close", (*) => (closed := true))
    dlg.OnEvent("Escape", (*) => (closed := true))

    CPControllerCaptureActive := true
    try {
        dlg.Show("w550 h210 Center")
        CPApplyOwnedDialogTheme(dlg)
        cancel.Focus()
        while !closed {
            snapshot := CPControllerReadSnapshot()
            if snapshot["connected"] {
                if !armed {
                    status.Value := "Detected " snapshot["name"] ". Release all buttons to arm capture."
                    if (snapshot["tokens"].Count = 0) {
                        armed := true
                        status.Value := "Ready. Press one controller button."
                    }
                } else if (result = "" && snapshot["tokens"].Count > 0) {
                    for token, _ in snapshot["tokens"] {
                        result := token
                        status.Value := "Assigned " CPControllerTokenDisplay(token) ". Release it to finish."
                        break
                    }
                } else if (result != "" && snapshot["tokens"].Count = 0) {
                    ; Keep exclusive ownership of the captured press until it
                    ; is released. Otherwise the same held shoulder reaches the
                    ; main navigation poll after this dialog closes and changes
                    ; the selected settings tab as an unintended second action.
                    closed := true
                }
            } else {
                status.Value := "No compatible controller detected."
            }
            Sleep(20)
        }
    } finally {
        try dlg.Destroy()
        CPControllerResetNavigation()
        CPControllerCaptureActive := false
    }
    return result
}

CPControllerAssign(action, *) {
    global hotkeyActions, hotkeyLabels, CPControllerBindings
    token := CPControllerCaptureDialog(action)
    if (token = "")
        return
    for otherAction in hotkeyActions {
        if (otherAction != action && CPControllerBindings.Has(otherAction)
         && CPControllerBindings[otherAction] = token) {
            response := MsgBox(
                CPControllerTokenDisplay(token) " is currently assigned to '"
                hotkeyLabels[otherAction] "'.`n`nMove it to '" hotkeyLabels[action] "'?",
                "Controller assignment", "YesNo Icon?")
            if (response != "Yes")
                return
            CPControllerSaveBinding(otherAction, "")
            break
        }
    }
    CPControllerSaveBinding(action, token)
}

CPControllerDisable(action, *) {
    CPControllerSaveBinding(action, "")
}

CPControllerSetEnabled(enabled, persist := true) {
    global iniPath, CPControllerInputsEnabled, CPControllerPreviousTokens
    global CPControllerLastDeviceName, CPControllerLastStatusText, cbControllerInputsEnabled
    CPControllerInputsEnabled := enabled ? true : false
    if IsSet(cbControllerInputsEnabled)
        cbControllerInputsEnabled.Value := CPControllerInputsEnabled ? 1 : 0
    if persist
        IniWrite(CPControllerInputsEnabled ? 1 : 0, iniPath, "controller_inputs", "enabled")
    CPControllerPreviousTokens := Map()
    CPControllerLastDeviceName := ""
    CPControllerLastStatusText := ""
    ; Basic foreground navigation is always available. When optional action
    ; bindings are off, the poll returns before reading a controller unless the
    ; control panel or one of its dialogs is actually in the foreground.
    SetTimer(CPControllerPoll, 20)
    CPControllerUpdateStatus()
}

CPControllerEnabledChanged(*) {
    global cbControllerInputsEnabled
    CPControllerSetEnabled(cbControllerInputsEnabled.Value != 0)
}

CPControllerSetDpadNavigationEnabled(enabled, persist := true) {
    global iniPath, CPControllerDpadNavigationEnabled
    global cbControllerDpadNavigationEnabled
    CPControllerDpadNavigationEnabled := enabled ? true : false
    if IsSet(cbControllerDpadNavigationEnabled)
        cbControllerDpadNavigationEnabled.Value := CPControllerDpadNavigationEnabled ? 1 : 0
    if persist
        IniWrite(CPControllerDpadNavigationEnabled ? 1 : 0, iniPath, "controller_inputs", "dpad_navigation")
    CPControllerResetNavigation()
}

CPControllerDpadNavigationChanged(*) {
    global cbControllerDpadNavigationEnabled
    CPControllerSetDpadNavigationEnabled(cbControllerDpadNavigationEnabled.Value != 0)
}

CPOverlayWindowHwnd(title) {
    oldMode := A_TitleMatchMode
    oldHidden := A_DetectHiddenWindows
    hwnd := 0
    try {
        SetTitleMatchMode(3)
        DetectHiddenWindows(true)
        hwnd := WinExist(title)
    } finally {
        DetectHiddenWindows(oldHidden)
        SetTitleMatchMode(oldMode)
    }
    return hwnd
}

CPControllerWriteOverlayCommand(commandName) {
    global overlayDir
    try {
        EnsureOverlayDir()
        commandPath := overlayDir "\" commandName
        if FileExist(commandPath)
            FileDelete(commandPath)
        FileAppend("", commandPath, "UTF-8")
        return true
    } catch as ex {
        DbgCP("Controller command failed for " commandName ": " ex.Message)
        return false
    }
}

CPControllerTranslatorAction(commandName) {
    if !CPOverlayWindowHwnd("Translator")
        LaunchOverlay()
    if !CPOverlayWindowHwnd("Translator") {
        Toast("Translator is not running")
        return
    }
    try ApplyShotSettings()
    CPControllerWriteOverlayCommand(commandName)
}

CPControllerToggleTranslator() {
    if CPOverlayWindowHwnd("Translator")
        CPControllerWriteOverlayCommand("cmd.toggle_translator")
    else
        LaunchOverlay()
}

CPControllerToggleExplainer() {
    if CPOverlayWindowHwnd("Explainer")
        CPControllerWriteOverlayCommand("cmd.toggle_explainer")
    else
        LaunchExplainerOverlay()
}

CPControllerDispatchAction(action) {
    try {
        switch action {
            case "screenshot_translate":
                CPControllerTranslatorAction("cmd.oneshot_translate")
            case "explain_last_translation":
                ExplainNow()
            case "hide_show_translator":
                CPControllerToggleTranslator()
            case "hide_show_explainer":
                CPControllerToggleExplainer()
            case "hide_show_control_panel":
                ToggleControlPanel()
            case "take_screenshot":
                CPControllerTranslatorAction("cmd.take_screenshot")
            case "screenshot_translation":
                CPControllerTranslatorAction("cmd.screenshot_translation")
            case "launch_explainer_request":
                CP_LaunchExplainerRequest()
            case "recapture_region":
                CPControllerTranslatorAction("cmd.recapture_region")
            case "start_stop_audio":
                StartStopAudio()
        }
    } catch as ex {
        DbgCP("Direct controller action failed for " action ": " ex.Message)
        Toast("Controller action failed")
    }
}

StudyControllerSurfaces(visibleOnly := true) {
    global CPStudyLibraryState, CPStudyReaderState, CPStudyCandidateState
    studySurfaces := []
    studySpecs := [
        ["candidates", CPStudyCandidateState],
        ["reader", CPStudyReaderState],
        ["library", CPStudyLibraryState]
    ]
    for studySpec in studySpecs {
        studyKind := studySpec[1], studyState := studySpec[2]
        studyAlive := studyKind = "candidates"
            ? StudyCandidatesGuiAlive(studyState)
            : StudyLibraryStateAlive(studyState)
        if !studyAlive
            continue
        try studyHwnd := studyState["gui"].Hwnd
        catch
            continue
        if (visibleOnly && !DllCall(
            "user32\IsWindowVisible", "ptr", studyHwnd, "int"
        ))
            continue
        studySurfaces.Push(Map(
            "kind", studyKind,
            "state", studyState,
            "hwnd", studyHwnd
        ))
    }
    return studySurfaces
}

StudyControllerSurfaceForWindow(hwnd, &surface) {
    surface := 0
    if !hwnd
        return false
    studyOwner := hwnd
    Loop 16 {
        for studyCandidate in StudyControllerSurfaces(false) {
            if (studyOwner = studyCandidate["hwnd"]) {
                surface := studyCandidate
                return true
            }
        }
        studyOwner := DllCall(
            "user32\GetWindow", "ptr", studyOwner,
            "uint", 4, "ptr" ; GW_OWNER
        )
        if !studyOwner
            break
    }
    return false
}

StudyControllerSurfaceIsRoot(hwnd) {
    if !StudyControllerSurfaceForWindow(hwnd, &studySurface)
        return false
    return hwnd = studySurface["hwnd"]
}

StudyControllerEnumFocusableProc(hwnd, lParam) {
    global __CP_STUDY_NAV_ITEMS
    if CPHwndIsFocusable(hwnd)
        __CP_STUDY_NAV_ITEMS.Push(hwnd)
    return true
}

StudyControllerFocusableHwnds(rootHwnd) {
    global __CP_STUDY_NAV_ITEMS
    __CP_STUDY_NAV_ITEMS := []
    if !rootHwnd
        return __CP_STUDY_NAV_ITEMS
    studyCallback := CallbackCreate(StudyControllerEnumFocusableProc)
    try DllCall(
        "user32\EnumChildWindows", "ptr", rootHwnd,
        "ptr", studyCallback, "ptr", 0
    )
    finally CallbackFree(studyCallback)
    return __CP_STUDY_NAV_ITEMS
}

StudyControllerFocusedHwnd(rootHwnd) {
    studyFocused := DllCall("user32\GetFocus", "ptr")
    if (studyFocused && (studyFocused = rootHwnd || DllCall(
        "user32\IsChild", "ptr", rootHwnd, "ptr", studyFocused, "int"
    )))
        return CPFocusRingTargetHwnd(studyFocused)
    try {
        studyGui := GuiFromHwnd(rootHwnd)
        studyCtrl := studyGui.FocusedCtrl
        return IsObject(studyCtrl) && studyCtrl.Hwnd
            ? CPFocusRingTargetHwnd(studyCtrl.Hwnd) : 0
    }
    return 0
}

StudyControllerSetFocus(rootHwnd, controlHwnd) {
    if !rootHwnd || !controlHwnd
        return false
    ; The prompt editor keeps its keyboard caret/selection when the controller
    ; returns from its actions, instead of native Focus selecting the whole text.
    studyEditSelection := 0
    try {
        studyGui := GuiFromHwnd(rootHwnd)
        if (studyGui.HasOwnProp("StudyPreserveEditSelection")
            && studyGui.StudyPreserveEditSelection
            && StudyControllerIsMultilineEdit(controlHwnd)
            && !StudyControllerIsReadOnlyEdit(controlHwnd)) {
            studyEditSelection := Buffer(8, 0)
            SendMessage(0x00B0, studyEditSelection.Ptr, studyEditSelection.Ptr + 4, controlHwnd)
        }
    }
    ; Reveal the normal Windows keyboard-focus cue without repainting every
    ; child. The Study windows keep their desktop appearance and avoid the
    ; all-control flash that a full RedrawWindow pass can cause.
    try SendMessage(
        0x0127, 0x00030002, 0, rootHwnd
    ) ; WM_CHANGEUISTATE, UIS_CLEAR, HIDEFOCUS|HIDEACCEL
    try {
        studyCtrl := GuiCtrlFromHwnd(controlHwnd)
        if IsObject(studyCtrl) {
            studyCtrl.Focus()
            if IsObject(studyEditSelection)
                SendMessage(0x00B1, NumGet(studyEditSelection, 0, "uint"),
                    NumGet(studyEditSelection, 4, "uint"), controlHwnd)
            StudyControllerClearReadOnlyEditSelection(controlHwnd)
            if StudyControllerSurfaceForWindow(rootHwnd, &studySurface)
                StudyBigBoxFocusFrameUpdate(
                    studySurface["state"], controlHwnd
                )
            return true
        }
    }
    try {
        ControlFocus("ahk_id " controlHwnd, "ahk_id " rootHwnd)
        if IsObject(studyEditSelection)
            SendMessage(0x00B1, NumGet(studyEditSelection, 0, "uint"),
                NumGet(studyEditSelection, 4, "uint"), controlHwnd)
        StudyControllerClearReadOnlyEditSelection(controlHwnd)
        if StudyControllerSurfaceForWindow(rootHwnd, &studySurface)
            StudyBigBoxFocusFrameUpdate(studySurface["state"], controlHwnd)
        return true
    }
    return false
}

StudyControllerControlClass(hwnd) {
    try return WinGetClass("ahk_id " hwnd)
    return ""
}

StudyControllerIsReadOnlyEdit(hwnd) {
    if (StudyControllerControlClass(hwnd) != "Edit")
        return false
    try {
        studyStyle := DllCall(
            "user32\GetWindowLongPtr", "ptr", hwnd, "int", -16, "ptr"
        )
        return (studyStyle & 0x0800) != 0 ; ES_READONLY
    }
    return false
}

StudyControllerClearReadOnlyEditSelection(hwnd) {
    if !StudyControllerIsReadOnlyEdit(hwnd)
        return false
    try {
        ; Read-only viewers should show a caret/focus border, not make their
        ; entire contents look selected when controller navigation enters.
        SendMessage(0x00B1, 0, 0, hwnd) ; EM_SETSEL
        return true
    }
    return false
}

StudyControllerIsReadOnlyMultilineEdit(hwnd) {
    if !StudyControllerIsReadOnlyEdit(hwnd)
        return false
    try {
        studyStyle := DllCall(
            "user32\GetWindowLongPtr", "ptr", hwnd, "int", -16, "ptr"
        )
        return (studyStyle & 0x0004) && (studyStyle & 0x0800)
    }
    return false
}

StudyControllerScrollReadOnlyEdit(hwnd, direction) {
    if !StudyControllerIsReadOnlyMultilineEdit(hwnd)
        return false
    return StudyControllerScrollMultilineEdit(hwnd, direction)
}

StudyControllerIsMultilineEdit(hwnd) {
    if StudyControllerControlClass(hwnd) != "Edit"
        return false
    try return (DllCall("user32\GetWindowLongPtr", "ptr", hwnd,
        "int", -16, "ptr") & 0x0004) != 0
    return false
}

StudyControllerScrollMultilineEdit(hwnd, direction) {
    if !StudyControllerIsMultilineEdit(hwnd)
        return false
    studyBeforeLine := 0, studyAfterLine := 0
    try studyBeforeLine := SendMessage(
        0x00CE, 0, 0, hwnd
    ) ; EM_GETFIRSTVISIBLELINE
    try SendMessage(
        0x0115, direction = "Up" ? 0 : 1, 0, hwnd
    ) ; WM_VSCROLL, SB_LINEUP/SB_LINEDOWN
    try studyAfterLine := SendMessage(
        0x00CE, 0, 0, hwnd
    ) ; EM_GETFIRSTVISIBLELINE
    return studyAfterLine != studyBeforeLine
}

StudyControllerSendKey(keyName) {
    global CPStudySyntheticKeyDepth
    CPStudySyntheticKeyDepth += 1
    try CPControllerSendDialogKey(keyName)
    finally CPStudySyntheticKeyDepth := Max(0, CPStudySyntheticKeyDepth - 1)
}

StudyControllerSendControlKey(hwnd, virtualKey) {
    if !hwnd
        return false
    try {
        DllCall(
            "user32\SendMessageW", "ptr", hwnd,
            "uint", 0x0100, "ptr", virtualKey, "ptr", 1, "ptr"
        ) ; WM_KEYDOWN
        DllCall(
            "user32\SendMessageW", "ptr", hwnd,
            "uint", 0x0101, "ptr", virtualKey,
            "ptr", 0xC0000001, "ptr"
        ) ; WM_KEYUP
        return true
    }
    return false
}

StudyControllerComboPreviewActive(hwnd) {
    global CPStudyComboTransactions
    if !hwnd || !CPStudyComboTransactions.Has(hwnd)
        return false
    if !DllCall("user32\IsWindow", "ptr", hwnd, "int") {
        CPStudyComboTransactions.Delete(hwnd)
        return false
    }
    return true
}

StudyControllerComboNeedsConfirmation(hwnd, studySurface) {
    if !hwnd || !IsObject(studySurface)
        return false
    studyState := studySurface["state"]
    if (studySurface["kind"] = "library")
        return studyState.Has("libraryDdl")
            && hwnd = studyState["libraryDdl"].Hwnd
    if (studySurface["kind"] != "candidates")
        return false
    return (studyState.Has("scopeDdl")
            && hwnd = studyState["scopeDdl"].Hwnd)
        || (studyState.Has("aiFilterDdl")
            && hwnd = studyState["aiFilterDdl"].Hwnd)
}

StudyControllerBeginComboSelection(hwnd, studySurface) {
    global CPStudyComboTransactions
    if !StudyControllerComboNeedsConfirmation(hwnd, studySurface)
        return CPShowCombo(hwnd, true)
    if !CPStudyComboTransactions.Has(hwnd) {
        studyOriginalValue := 0
        try studyOriginalValue := GuiCtrlFromHwnd(hwnd).Value
        CPStudyComboTransactions[hwnd] := Map(
            "originalValue", studyOriginalValue
        )
    }
    return CPShowCombo(hwnd, true)
}

StudyControllerCommitComboSelection(hwnd, studySurface) {
    global CPStudyComboTransactions
    if !StudyControllerComboPreviewActive(hwnd)
        return StudyControllerSendControlKey(hwnd, 0x0D)
    studyTransaction := CPStudyComboTransactions[hwnd]
    studySelectedValue := studyTransaction["originalValue"]
    try studySelectedValue := GuiCtrlFromHwnd(hwnd).Value
    ; Keep the transaction active while Windows closes the list so any final
    ; native Change notification is still treated as a preview.
    StudyControllerSendControlKey(hwnd, 0x0D)
    CPStudyComboTransactions.Delete(hwnd)
    if (studySelectedValue != studyTransaction["originalValue"]
        && IsObject(studySurface)) {
        studyState := studySurface["state"]
        if (studySurface["kind"] = "library") {
            if (studyState.Has("libraryDdl")
                && hwnd = studyState["libraryDdl"].Hwnd)
                StudyLibraryLibraryChanged(studyState)
        } else if (studySurface["kind"] = "candidates") {
            if (studyState.Has("scopeDdl")
                && hwnd = studyState["scopeDdl"].Hwnd)
                StudyCandidatesScopeChanged(studyState)
            else if (studyState.Has("aiFilterDdl")
                && hwnd = studyState["aiFilterDdl"].Hwnd)
                StudyCandidatesAiFilterChanged(studyState)
        }
    }
    return true
}

StudyControllerCancelComboSelection(hwnd) {
    global CPStudyComboTransactions
    if !StudyControllerComboPreviewActive(hwnd)
        return CPShowCombo(hwnd, false)
    studyTransaction := CPStudyComboTransactions[hwnd]
    try GuiCtrlFromHwnd(hwnd).Choose(studyTransaction["originalValue"])
    CPShowCombo(hwnd, false)
    CPStudyComboTransactions.Delete(hwnd)
    return true
}

StudyControllerListViewCanMove(hwnd, direction) {
    if (StudyControllerControlClass(hwnd) != "SysListView32")
        return false
    studyCount := 0, studyFocusedIndex := -1
    try studyCount := SendMessage(0x1004, 0, 0, hwnd) ; LVM_GETITEMCOUNT
    if (studyCount <= 0)
        return false
    try studyFocusedIndex := SendMessage(
        0x100C, -1, 0x0001, hwnd
    ) ; LVM_GETNEXTITEM, LVNI_FOCUSED
    if (studyFocusedIndex < 0)
        return true
    return direction = "Up"
        ? studyFocusedIndex > 0
        : studyFocusedIndex < studyCount - 1
}

StudyControllerScrollTable(hwnd, direction, scale := 1) {
    if (StudyControllerControlClass(hwnd) != "SysListView32"
        || (direction != "Left" && direction != "Right"))
        return false
    studyScroll := Buffer(28, 0)
    NumPut("uint", 28, studyScroll, 0)
    NumPut("uint", 0x7, studyScroll, 4) ; SIF_RANGE | SIF_PAGE | SIF_POS
    if !DllCall("user32\GetScrollInfo", "ptr", hwnd, "int", 0,
        "ptr", studyScroll.Ptr, "int") ; SB_HORZ
        return false
    studyMin := NumGet(studyScroll, 8, "int")
    studyMax := Max(studyMin, NumGet(studyScroll, 12, "int")
        - Max(0, NumGet(studyScroll, 16, "uint") - 1))
    studyPos := NumGet(studyScroll, 20, "int")
    studyRemaining := direction = "Left"
        ? studyPos - studyMin : studyMax - studyPos
    if (studyRemaining <= 0)
        return false
    studyStep := Min(studyRemaining, Round(180 * Max(0.72, scale)))
    try {
        SendMessage(0x1014, direction = "Left" ? -studyStep : studyStep,
            0, hwnd) ; LVM_SCROLL: pixels, preserves the selected row
        ; Reaching the edge consumes this move. Only a subsequent move at the
        ; edge can leave the table, just as Up/Down exits at the first/last row.
        return true
    }
    return false
}

StudyControllerMoveFocus(rootHwnd, direction) {
    studyItems := StudyControllerFocusableHwnds(rootHwnd)
    if !studyItems.Length
        return false
    studyCurrent := StudyControllerFocusedHwnd(rootHwnd)
    if !studyCurrent
        return StudyControllerSetFocus(rootHwnd, studyItems[1])

    studyCurrentRect := CPGetHwndRect(studyCurrent)
    studyBestHwnd := 0, studyBestScore := 0
    for studyHwnd in studyItems {
        if (studyHwnd = studyCurrent)
            continue
        studyRect := CPGetHwndRect(studyHwnd)
        studyDx := studyRect["cx"] - studyCurrentRect["cx"]
        studyDy := studyRect["cy"] - studyCurrentRect["cy"]
        studyOverlap := false
        if (direction = "Up") {
            studyPrimary := -studyDy
            if (studyPrimary <= 4)
                continue
            studyOverlap := studyRect["r"] > studyCurrentRect["l"]
                && studyRect["l"] < studyCurrentRect["r"]
        } else if (direction = "Down") {
            studyPrimary := studyDy
            if (studyPrimary <= 4)
                continue
            studyOverlap := studyRect["r"] > studyCurrentRect["l"]
                && studyRect["l"] < studyCurrentRect["r"]
        } else if (direction = "Left") {
            studyPrimary := -studyDx
            if (studyPrimary <= 4)
                continue
            studyOverlap := studyRect["b"] > studyCurrentRect["t"]
                && studyRect["t"] < studyCurrentRect["b"]
            ; Left/Right means move within the current visual row. A diagonally
            ; closer control in the row above or below must not steal focus;
            ; users change rows explicitly with Up/Down.
            if !studyOverlap
                continue
        } else {
            studyPrimary := studyDx
            if (studyPrimary <= 4)
                continue
            studyOverlap := studyRect["b"] > studyCurrentRect["t"]
                && studyRect["t"] < studyCurrentRect["b"]
            if !studyOverlap
                continue
        }
        studySecondary := (direction = "Up" || direction = "Down")
            ? Abs(studyDx) : Abs(studyDy)
        ; Use actual two-dimensional proximity. The previous primary-axis-heavy
        ; score could jump to a visibly distant button merely because its near
        ; edge was a few pixels closer. A small alignment preference resolves
        ; otherwise-similar candidates without overriding the nearest control.
        studyScore := studyPrimary * studyPrimary
            + studySecondary * studySecondary
        if !studyOverlap
            studyScore *= 1.15
        if (!studyBestHwnd || studyScore < studyBestScore) {
            studyBestHwnd := studyHwnd
            studyBestScore := studyScore
        }
    }
    if studyBestHwnd
        return StudyControllerSetFocus(rootHwnd, studyBestHwnd)
    ; Spatial navigation should stop at a visual edge. Wrapping to an unrelated
    ; control on the opposite side of a Study window feels like a random jump.
    return false
}

StudyControllerMove(direction, targetHwnd, studySurface) {
    studyRoot := studySurface["hwnd"]
    studyFocused := StudyControllerFocusedHwnd(targetHwnd)
    studyClass := StudyControllerControlClass(studyFocused)

    if (studyFocused && CPHwndIsCombo(studyFocused)
        && CPComboDropped(studyFocused)) {
        studyVk := direction = "Up" ? 0x26
            : direction = "Down" ? 0x28
            : direction = "Left" ? 0x25 : 0x27
        return StudyControllerSendControlKey(studyFocused, studyVk)
    }
    try {
        studyGui := GuiFromHwnd(targetHwnd)
        if studyGui.HasOwnProp("StudyLibraryManagementForm") {
            studyManagement := studyGui.StudyLibraryManagementForm
            if studyManagement.Has("list") && studyFocused = studyManagement["list"].Hwnd {
                if direction = "Up" || direction = "Down" {
                    if StudyControllerListViewCanMove(studyFocused, direction)
                        return StudyControllerSendControlKey(studyFocused, direction = "Up" ? 0x26 : 0x28)
                } else if StudyControllerScrollTable(studyFocused, direction, 1)
                    return true
                if direction = "Right" {
                    StudyLibraryManagementListActions(studyManagement)
                    return true
                }
                return StudyControllerMoveFocus(targetHwnd, direction)
            }
        }
        if studyGui.HasOwnProp("StudyVocabularyPicker")
            && studyFocused = studyGui.StudyVocabularyPicker["controls"]["list"].Hwnd
            && (direction = "Up" || direction = "Down") {
            if StudyControllerListViewCanMove(studyFocused, direction)
                return StudyControllerSendControlKey(studyFocused, direction = "Up" ? 0x26 : 0x28)
            ; The only action below the list is Back, across from the static hint.
            if direction = "Down"
                return StudyControllerSetFocus(targetHwnd, studyGui.StudyVocabularyPicker["controls"]["back"].Hwnd)
            return StudyControllerMoveFocus(targetHwnd, direction)
        }
        studyLinkKey := studyFocused "|" direction
        if studyGui.HasOwnProp("StudyDirectionalFocus")
            && studyGui.StudyDirectionalFocus.Has(studyLinkKey) {
            studyNeighbor := studyGui.StudyDirectionalFocus[studyLinkKey]
            if CPHwndIsFocusable(studyNeighbor) {
                ; Explicit editor neighbors apply only at the scroll boundary,
                ; just like the normal spatial-navigation fallback below.
                if StudyControllerIsMultilineEdit(studyFocused)
                    && (direction = "Up" || direction = "Down")
                    && StudyControllerScrollMultilineEdit(studyFocused, direction)
                    return true
                return StudyControllerSetFocus(targetHwnd, studyNeighbor)
            }
        }
    }
    if (targetHwnd = studyRoot && studyClass = "SysListView32"
        && (direction = "Left" || direction = "Right")) {
        if StudyControllerScrollTable(studyFocused, direction,
            studySurface["state"].Get("bigBoxLayoutScale", 1))
            return true
        return StudyControllerMoveFocus(targetHwnd, direction)
    }
    if (targetHwnd = studyRoot && studyClass = "SysListView32"
        && (direction = "Up" || direction = "Down")) {
        if StudyControllerListViewCanMove(studyFocused, direction)
            return StudyControllerSendControlKey(
                studyFocused, direction = "Up" ? 0x26 : 0x28
            )
        ; At the first/last real row, continue into the controls above/below the
        ; table instead of trapping D-pad navigation inside the ListView.
        return StudyControllerMoveFocus(targetHwnd, direction)
    }
    if (StudyControllerIsMultilineEdit(studyFocused)
        && (direction = "Up" || direction = "Down")) {
        if StudyControllerScrollMultilineEdit(studyFocused, direction)
            return true
        ; Once the viewer reaches its first/last visible line—or when all text
        ; already fits—continue to the nearest control in that direction.
        return StudyControllerMoveFocus(targetHwnd, direction)
    }
    if (targetHwnd = studyRoot && studySurface["kind"] = "candidates"
        && studyFocused = studySurface["state"]["tabs"].Hwnd
        && (direction = "Left" || direction = "Right")) {
        studySurface["state"]["tabs"].Choose(direction = "Left" ? 1 : 2)
        StudyCandidatesTabChanged(studySurface["state"])
        return true
    }
    return StudyControllerMoveFocus(targetHwnd, direction)
}

StudyControllerActivate(targetHwnd, studySurface) {
    studyState := studySurface["state"]
    studyFocused := StudyControllerFocusedHwnd(targetHwnd)
    if !studyFocused
        return StudyControllerMoveFocus(targetHwnd, "Down")
    try {
        studyGui := GuiFromHwnd(targetHwnd)
        if studyGui.HasOwnProp("StudyLibraryManagementForm") {
            studyManagement := studyGui.StudyLibraryManagementForm
            if studyManagement.Has("list") && studyFocused = studyManagement["list"].Hwnd {
                StudyLibraryManagementListActions(studyManagement)
                return true
            }
        }
        if studyGui.HasOwnProp("StudyVocabularyPicker")
            && studyFocused = studyGui.StudyVocabularyPicker["controls"]["list"].Hwnd {
            StudyReaderVocabularyPickerChoose(studyGui.StudyVocabularyPicker)
            return true
        }
    }
    if CPHwndIsCombo(studyFocused) {
        if !CPComboDropped(studyFocused)
            return StudyControllerBeginComboSelection(
                studyFocused, studySurface
            )
        return StudyControllerCommitComboSelection(
            studyFocused, studySurface
        )
    }
    if (targetHwnd = studySurface["hwnd"]
        && studySurface["kind"] = "library"
        && studyFocused = studyState["list"].Hwnd) {
        StudyLibraryOpenSelectedReader(studyState)
        return true
    }
    if (targetHwnd = studySurface["hwnd"]
        && studySurface["kind"] = "candidates"
        && (studyFocused = studyState["sentenceList"].Hwnd
            || studyFocused = studyState["vocabularyList"].Hwnd)) {
        if StudyCandidatesBigBoxPresentation(studyState)
            StudyCandidatesShowSelectedActions(studyState)
        else
            StudyCandidatesOpenSelected(studyState)
        return true
    }
    if (StudyControllerControlClass(studyFocused) = "Button") {
        try {
            SendMessage(0x00F5, 0, 0, studyFocused) ; BM_CLICK
            return true
        }
    }
    if StudyControllerIsReadOnlyMultilineEdit(studyFocused)
        return true
    StudyControllerSendKey("Enter")
    return true
}

StudyControllerCancel(targetHwnd, studySurface) {
    studyFocused := StudyControllerFocusedHwnd(targetHwnd)
    if (studyFocused && CPHwndIsCombo(studyFocused)
        && CPComboDropped(studyFocused))
        return StudyControllerCancelComboSelection(studyFocused)
    try {
        studyGui := GuiFromHwnd(targetHwnd)
        if studyGui.HasOwnProp("StudyOwnedMessage") {
            studyMessage := studyGui.StudyOwnedMessage
            StudyLibraryOwnedMessageClose(studyMessage, studyMessage["result"])
            return true
        }
        if studyGui.HasOwnProp("StudyLibraryManagementForm") {
            StudyLibraryManagementClose(studyGui)
            return true
        }
        if studyGui.HasOwnProp("StudyChapterForm") {
            StudyLibraryCloseCurrentChapterDialog(studyGui.StudyChapterForm["libraryState"], studyGui)
            return true
        }
        if studyGui.HasOwnProp("StudyAnkiPreview") {
            StudyReaderCloseAnkiAddDialog(studyGui.StudyAnkiPreview)
            return true
        }
        if studyGui.HasOwnProp("StudyVocabularyPicker") {
            StudyReaderVocabularyPickerClose(studyGui.StudyVocabularyPicker)
            return true
        }
    }
    if (targetHwnd != studySurface["hwnd"]) {
        StudyControllerSendKey("Esc")
        return true
    }
    switch studySurface["kind"] {
        case "library":
            StudyLibraryClose(studySurface["state"])
        case "reader":
            StudyReaderClose(studySurface["state"])
        case "candidates":
            StudyCandidatesClose(studySurface["state"])
    }
    return true
}

StudyControllerSwitchPage(direction, studySurface) {
    studyState := studySurface["state"]
    switch studySurface["kind"] {
        case "reader":
            StudyReaderStepEntry(studyState, direction)
        case "candidates":
            studyState["tabs"].Choose(direction < 0 ? 1 : 2)
            StudyCandidatesTabChanged(studyState)
        case "library":
            ; The Library has no peer pages. Consume shoulders so they cannot
            ; leak through to a game or to the hidden desktop control center.
    }
    return true
}

StudyControllerHandleChoicePopup(command, targetHwnd) {
    studyPopupRegistry := CPThemedChoicePopupRegistry()
    if !studyPopupRegistry.Has(targetHwnd)
        return false
    studyPopupState := studyPopupRegistry[targetHwnd]
    if studyPopupState["closed"]
        return true
    switch command {
        case "Up", "Left":
            CPThemedChoicePopupFocus(
                studyPopupState, studyPopupState["focusIndex"] - 1
            )
        case "Down", "Right":
            CPThemedChoicePopupFocus(
                studyPopupState, studyPopupState["focusIndex"] + 1
            )
        case "Activate":
            studyPopupIndex := studyPopupState["focusIndex"]
            if (studyPopupIndex < 1
                || studyPopupIndex > studyPopupState["rows"].Length)
                return true
            studyPopupResult := studyPopupState.Has("resultValues")
                ? studyPopupState["resultValues"][studyPopupIndex]
                : studyPopupIndex
            CPThemedChoicePopupFinish(
                studyPopupState, studyPopupState["gui"], studyPopupResult
            )
        case "Cancel":
            CPThemedChoicePopupFinish(
                studyPopupState, studyPopupState["gui"], 0
            )
    }
    return true
}

StudyControllerDispatchNavigation(command, targetHwnd) {
    global CPControllerLastNativeNavigationAt
    if !StudyControllerSurfaceForWindow(targetHwnd, &studySurface)
        return false
    CPControllerLastNativeNavigationAt[command] := A_TickCount
    if studySurface["kind"] = "library" && targetHwnd = studySurface["hwnd"]
        StudyLibraryClearButtonHover(studySurface["state"])
    try {
        studyGui := GuiFromHwnd(targetHwnd)
        if studyGui.HasOwnProp("StudyVocabularyPicker")
            && studyGui.StudyVocabularyPicker.Get("pending", false) && command != "Cancel"
            return true ; Keep the chosen row stable while its review is opening.
    }

    ; Handle the custom menu state directly. These rows are lightweight Static
    ; controls; relying on Windows to forward synthetic key messages through the
    ; focused row is inconsistent across Windows versions and controller paths.
    if StudyControllerHandleChoicePopup(command, targetHwnd)
        return true
    if StudyLibraryDatePickerNavigate(command, targetHwnd)
        return true

    switch command {
        case "Up", "Down", "Left", "Right":
            StudyControllerMove(command, targetHwnd, studySurface)
        case "Activate":
            StudyControllerActivate(targetHwnd, studySurface)
        case "Cancel":
            StudyControllerCancel(targetHwnd, studySurface)
        case "PreviousTab":
            if (targetHwnd = studySurface["hwnd"])
                StudyControllerSwitchPage(-1, studySurface)
        case "NextTab":
            if (targetHwnd = studySurface["hwnd"])
                StudyControllerSwitchPage(1, studySurface)
    }
    return true
}

StudyControllerMirrorGuardActive(command, *) {
    global CPStudySyntheticKeyDepth
    if CPStudySyntheticKeyDepth > 0
        return false
    studyTarget := CPControllerNavigationTarget()
    return studyTarget
        && StudyControllerSurfaceForWindow(studyTarget, &studySurface)
        && CPControllerKeyboardMirrorActive(command)
}

StudyControllerConsumeMirroredKey(*) {
}

RegisterStudyControllerMirrorGuards() {
    global __CP_STUDY_MIRROR_BOUND
    if (IsSet(__CP_STUDY_MIRROR_BOUND) && __CP_STUDY_MIRROR_BOUND)
        return
    studyBindings := [
        ["$Up", "Up"], ["$Down", "Down"],
        ["$Left", "Left"], ["$Right", "Right"],
        ["$Enter", "Activate"], ["$NumpadEnter", "Activate"],
        ["$Space", "Activate"], ["$Esc", "Cancel"],
        ["$PgUp", "PreviousTab"], ["$PgDn", "NextTab"]
    ]
    for studyBinding in studyBindings {
        HotIf(StudyControllerMirrorGuardActive.Bind(studyBinding[2]))
        try Hotkey(
            studyBinding[1], StudyControllerConsumeMirroredKey, "On"
        )
    }
    HotIf()
    __CP_STUDY_MIRROR_BOUND := true
}

CPControllerNavigationTarget(cpNavForeground := 0) {
    global ui, CPBigBoxGui
    if !cpNavForeground
        cpNavForeground := DllCall("user32\GetForegroundWindow", "ptr")
    if !cpNavForeground
        return 0

    cpNavRoots := []
    for studySurface in StudyControllerSurfaces()
        cpNavRoots.Push(studySurface["hwnd"])
    if (CPBigBoxDashboardAlive() && DllCall(
        "user32\IsWindowVisible", "ptr", CPBigBoxGui.Hwnd, "int"
    ))
        cpNavRoots.Push(CPBigBoxGui.Hwnd)
    if (IsSet(ui) && ui && ui.Hwnd && DllCall(
        "user32\IsWindowVisible", "ptr", ui.Hwnd, "int"
    ))
        cpNavRoots.Push(ui.Hwnd)

    for cpNavRoot in cpNavRoots {
        ; Owned dialogs are part of their control-surface workflow. Follow the
        ; owner chain instead of matching titles so future dialogs inherit the
        ; same default controller navigation safely.
        cpNavOwner := cpNavForeground
        Loop 16 {
            if (cpNavOwner = cpNavRoot)
                return cpNavForeground
            cpNavOwner := DllCall(
                "user32\GetWindow", "ptr", cpNavOwner,
                "uint", 4, "ptr" ; GW_OWNER
            )
            if !cpNavOwner
                break
        }
    }
    return 0
}

CPControllerNavigationState(snapshot) {
    global CPControllerDpadNavigationEnabled
    cpNavTokens := snapshot["tokens"]
    cpNavIsXInput := InStr(snapshot["name"], "XInput controller ") = 1
    cpNavIsPlayStation := RegExMatch(snapshot["name"], "i)(DualSense|DualShock|Wireless Controller|PlayStation)")
    cpNavConfirmToken := cpNavIsPlayStation ? "J:Button 2" : "J:Button 1"
    cpNavCancelToken := cpNavIsPlayStation ? "J:Button 3" : "J:Button 2"
    cpNavDpadEnabled := CPControllerDpadNavigationEnabled

    return Map(
        "Up", cpNavDpadEnabled && cpNavTokens.Has(cpNavIsXInput ? "X:DPAD_UP" : "J:D-pad Up"),
        "Down", cpNavDpadEnabled && cpNavTokens.Has(cpNavIsXInput ? "X:DPAD_DOWN" : "J:D-pad Down"),
        "Left", cpNavDpadEnabled && cpNavTokens.Has(cpNavIsXInput ? "X:DPAD_LEFT" : "J:D-pad Left"),
        "Right", cpNavDpadEnabled && cpNavTokens.Has(cpNavIsXInput ? "X:DPAD_RIGHT" : "J:D-pad Right"),
        "PreviousTab", cpNavTokens.Has(cpNavIsXInput ? "X:LB" : "J:Button 5"),
        "NextTab", cpNavTokens.Has(cpNavIsXInput ? "X:RB" : "J:Button 6"),
        "Activate", cpNavTokens.Has(cpNavIsXInput ? "X:A" : cpNavConfirmToken),
        "Cancel", cpNavTokens.Has(cpNavIsXInput ? "X:B" : cpNavCancelToken)
    )
}

CPControllerResetNavigation(targetHwnd := 0, navState := 0) {
    global CPControllerNavPreviousState, CPControllerNavTargetHwnd
    global CPControllerNavHeldDirection, CPControllerNavNextRepeatAt, CPControllerNavHeldSince
    CPControllerNavTargetHwnd := targetHwnd
    CPControllerNavPreviousState := IsObject(navState) ? navState : Map()
    CPControllerNavHeldDirection := ""
    CPControllerNavNextRepeatAt := 0
    CPControllerNavHeldSince := 0
}

CPControllerBeginSurfaceTransition(*) {
    global CPControllerSurfaceTransitionState
    ; "busy" blocks every controller command while the destination surface is
    ; being constructed. A timer poll can interrupt RunWait/Sleep during that
    ; work, so a simple target-HWND baseline is not sufficient by itself.
    CPControllerSurfaceTransitionState := "busy"
    CPControllerResetNavigation()
}

CPControllerFinishSurfaceTransition(*) {
    global CPControllerSurfaceTransitionState
    ; Do not use a guessed millisecond delay. The new surface remains guarded
    ; until the actual navigation inputs are physically released.
    CPControllerSurfaceTransitionState := "release"
    CPControllerResetNavigation()
}

CPControllerSurfaceTransitionBlocks(navState, targetHwnd) {
    global CPControllerSurfaceTransitionState
    if (CPControllerSurfaceTransitionState = "")
        return false
    if (CPControllerSurfaceTransitionState = "release") {
        cpTransitionReleased := true
        for cpTransitionCommand in [
            "Up", "Down", "Left", "Right", "PreviousTab", "NextTab",
            "Activate", "Cancel"
        ] {
            if navState[cpTransitionCommand] {
                cpTransitionReleased := false
                break
            }
        }
        if cpTransitionReleased
            CPControllerSurfaceTransitionState := ""
    }
    ; Consume both held-input frames and the first fully released frame. The
    ; following press is therefore a clean edge belonging to the new surface.
    CPControllerResetNavigation(targetHwnd, navState)
    return true
}

CPControllerSendDialogKey(keyName) {
    ; A send level above the dialog hotkeys' default input level lets existing
    ; custom keyboard navigation handle the event. Dialogs without custom
    ; handlers simply receive the native key.
    try {
        SendLevel(1)
        SendEvent("{" keyName "}")
    } finally {
        SendLevel(0)
    }
}

CPControllerDispatchNavigation(command, targetHwnd) {
    global ui, CPBigBoxGui, CPControllerLastNativeNavigationAt

    if (CPBigBoxDashboardAlive() && targetHwnd = CPBigBoxGui.Hwnd) {
        CPControllerLastNativeNavigationAt[command] := A_TickCount
        switch command {
            case "Up", "Down", "Left", "Right":
                CPBigBoxDashboardMoveFocus(command)
            case "Activate":
                CPBigBoxDashboardActivate()
            case "Cancel":
                CPBigBoxBack()
            case "PreviousTab":
                CPBigBoxSwitchPage(-1)
            case "NextTab":
                CPBigBoxSwitchPage(1)
        }
        return
    }

    if (targetHwnd = ui.Hwnd) {
        CPControllerLastNativeNavigationAt[command] := A_TickCount
        switch command {
            case "Up", "Down", "Left", "Right":
                CPNavMove(command)
            case "PreviousTab":
                CPNavSwitchTab(-1)
            case "NextTab":
                CPNavSwitchTab(1)
            case "Activate":
                ; Bypass the keyboard mirror guard: this command originated
                ; from the native controller path itself.
                CPNavActivate("Enter")
            case "Cancel":
                CPNavCancelCurrent()
        }
        return
    }

    if StudyControllerDispatchNavigation(command, targetHwnd)
        return

    if CPControllerColorDispatch(command, targetHwnd)
        return

    switch command {
        case "Up", "Down", "Left", "Right":
            CPControllerSendDialogKey(command)
        case "Activate":
            CPControllerSendDialogKey("Enter")
        case "Cancel":
            CPControllerSendDialogKey("Esc")
    }
}

CPControllerHandleNavigation(snapshot, targetHwnd) {
    global CPBigBoxGui
    global CPControllerNavPreviousState, CPControllerNavTargetHwnd
    global CPControllerNavHeldDirection, CPControllerNavNextRepeatAt, CPControllerNavHeldSince
    cpNavState := CPControllerNavigationState(snapshot)

    if CPControllerSurfaceTransitionBlocks(cpNavState, targetHwnd)
        return

    ; Opening the panel with a controller button must not immediately activate
    ; whichever control receives focus. The first frame establishes a baseline.
    if (targetHwnd != CPControllerNavTargetHwnd || CPControllerNavPreviousState.Count = 0) {
        CPControllerResetNavigation(targetHwnd, cpNavState)
        return
    }

    cpNavDirections := ["Up", "Down", "Left", "Right"]
    cpNavNewDirection := ""
    for cpNavDirection in cpNavDirections {
        if (cpNavState[cpNavDirection] && !CPControllerNavPreviousState[cpNavDirection]) {
            cpNavNewDirection := cpNavDirection
            break
        }
    }

    if (cpNavNewDirection != "") {
        CPControllerDispatchNavigation(cpNavNewDirection, targetHwnd)
        CPControllerNavHeldDirection := cpNavNewDirection
        CPControllerNavHeldSince := A_TickCount
        cpNavAcceleratedSliderRepeat := CPControllerAcceleratedSliderRepeatActive(targetHwnd, cpNavNewDirection)
        CPControllerNavNextRepeatAt := A_TickCount + (cpNavAcceleratedSliderRepeat ? 280 : 340)
    } else if (CPControllerNavHeldDirection != "" && cpNavState[CPControllerNavHeldDirection]) {
        if (A_TickCount >= CPControllerNavNextRepeatAt) {
            ; Tab changes are discrete controller actions. Repeating a held
            ; D-pad direction here makes a single deliberate press skip tabs,
            ; especially when a mapper also mirrors it as an arrow key.
            cpNavFocusedHwnd := targetHwnd = ui.Hwnd ? CPFocusedHwnd() : 0
            cpNavAcceleratedSliderRepeat := CPControllerAcceleratedSliderRepeatActive(
                targetHwnd, CPControllerNavHeldDirection)
            cpNavRepeatSteps := 1
            cpNavRepeatDelay := 90
            if cpNavAcceleratedSliderRepeat {
                cpNavHeldMs := A_TickCount - CPControllerNavHeldSince
                cpNavRepeatSteps := cpNavHeldMs >= 1100 ? 4 : (cpNavHeldMs >= 650 ? 2 : 1)
                cpNavRepeatDelay := 55
            }
            if !(cpNavFocusedHwnd && CPHwndIsTab(cpNavFocusedHwnd)) {
                Loop cpNavRepeatSteps
                    CPControllerDispatchNavigation(CPControllerNavHeldDirection, targetHwnd)
            }
            CPControllerNavNextRepeatAt := A_TickCount + cpNavRepeatDelay
        }
    } else {
        CPControllerNavHeldDirection := ""
        CPControllerNavNextRepeatAt := 0
        CPControllerNavHeldSince := 0
    }

    if (cpNavState["Activate"] && !CPControllerNavPreviousState["Activate"])
        CPControllerDispatchNavigation("Activate", targetHwnd)
    if (cpNavState["Cancel"] && !CPControllerNavPreviousState["Cancel"])
        CPControllerDispatchNavigation("Cancel", targetHwnd)
    ; Shoulder navigation is intentionally edge-triggered: holding a button
    ; must never skip several settings tabs. Owned dialogs continue suppressing
    ; gameplay actions but do not reinterpret the shoulders as dialog input.
    if (targetHwnd = ui.Hwnd
        || (CPBigBoxDashboardAlive() && targetHwnd = CPBigBoxGui.Hwnd)
        || StudyControllerSurfaceIsRoot(targetHwnd)) {
        if (cpNavState["PreviousTab"] && !CPControllerNavPreviousState["PreviousTab"])
            CPControllerDispatchNavigation("PreviousTab", targetHwnd)
        if (cpNavState["NextTab"] && !CPControllerNavPreviousState["NextTab"])
            CPControllerDispatchNavigation("NextTab", targetHwnd)
    }

    CPControllerNavPreviousState := cpNavState
}

CPControllerPoll(*) {
    global CPControllerInputsEnabled, CPControllerCaptureActive
    global CPControllerPreviousTokens, CPControllerBindings, hotkeyActions
    global CPControllerLastDeviceName, CPOverlayAdjustState
    if CPControllerCaptureActive
        return
    if ((CPOverlayAdjustState.Has("active") && CPOverlayAdjustState["active"])
     || CPControllerModalFlagActive()) {
        CPControllerPreviousTokens := Map()
        CPControllerResetNavigation()
        return
    }

    cpNavTarget := CPControllerNavigationTarget()
    if (!CPControllerInputsEnabled && !cpNavTarget) {
        CPControllerResetNavigation()
        return
    }

    snapshot := CPControllerReadSnapshot()
    CPControllerUpdateStatus(snapshot)
    if !snapshot["connected"] {
        CPControllerPreviousTokens := Map()
        CPControllerLastDeviceName := ""
        CPControllerResetNavigation(cpNavTarget)
        return
    }

    if cpNavTarget {
        CPControllerHandleNavigation(snapshot, cpNavTarget)
        CPControllerPreviousTokens := snapshot["tokens"]
        CPControllerLastDeviceName := snapshot["name"]
        return
    }

    CPControllerResetNavigation()
    if !CPControllerInputsEnabled
        return

    ; On connection or controller changes, use the first frame only as the
    ; baseline so a button already being held cannot trigger unexpectedly.
    if (snapshot["name"] != CPControllerLastDeviceName) {
        CPControllerLastDeviceName := snapshot["name"]
        CPControllerPreviousTokens := snapshot["tokens"]
        return
    }

    for actionKey in hotkeyActions {
        if !CPControllerBindings.Has(actionKey)
            continue
        token := CPControllerBindings[actionKey]
        if (token != "" && snapshot["tokens"].Has(token)
         && !CPControllerPreviousTokens.Has(token)) {
            CPControllerDispatchAction(actionKey)
        }
    }
    CPControllerPreviousTokens := snapshot["tokens"]
}

CPAddControlsViewControl(viewName, ctrl) {
    global CPControlsKeyboardControls, CPControlsControllerControls
    if (viewName = "controller")
        CPControlsControllerControls.Push(ctrl)
    else
        CPControlsKeyboardControls.Push(ctrl)
    return ctrl
}

CPSetControlsView(viewName, persist := true, *) {
    global iniPath, CPControlsCurrentView, CPControlsKeyboardControls, CPControlsControllerControls
    global rbControlsKeyboard, rbControlsController
    if (viewName != "controller")
        viewName := "keyboard"
    CPControlsCurrentView := viewName
    if IsSet(rbControlsKeyboard)
        rbControlsKeyboard.Value := viewName = "keyboard" ? 1 : 0
    if IsSet(rbControlsController)
        rbControlsController.Value := viewName = "controller" ? 1 : 0
    ; The modern layout reveals the new view atomically. Do not briefly show
    ; the old headers or move the hidden view's controls over another page.
    if !CPDesktopActive() {
        for ctrl in CPControlsKeyboardControls
            try ctrl.Visible := viewName = "keyboard"
        for ctrl in CPControlsControllerControls
            try ctrl.Visible := viewName = "controller"
    }
    if persist
        IniWrite(viewName, iniPath, "controller_inputs", "view")
    global tab
    if CPDesktopActive() && tab.Value = 8
        CPDesktopRelayout()
}
