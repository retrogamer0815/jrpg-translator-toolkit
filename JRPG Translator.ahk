    CPBigBoxUpdateAudioPower()
    CPBigBoxUpdateCaptureContent()
    CPBigBoxUpdateOverlayContent()
    CPBigBoxUpdateControlsContent()
    CPBigBoxUpdateTerminologyContent()
    CPBigBoxUpdateProfilesContent()
    CPBigBoxUpdateManageContent()
