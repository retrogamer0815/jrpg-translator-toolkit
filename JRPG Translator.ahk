}

CPThemedChoicePopupResetRows(cpPopupState) {
    ; The generic owned-dialog theme paints Text controls with the window
    ; background.  Restore every popup row—not only the initially focused
    ; one—so visiting and leaving a row cannot permanently change its shade.
    cpColors := cpPopupState["colors"]
    for cpRow in cpPopupState["rows"]
        try cpRow.Opt(
            "+Background" cpColors["surface"] " c" cpColors["text"]
        )
    if cpPopupState.Has("disabledRows") {
        for cpRow in cpPopupState["disabledRows"]
            try cpRow.Opt(
                "+Background" cpColors["surface"] " c" cpColors["muted"]
            )
    }
    for cpRow in cpPopupState["rows"]
        try DllCall(
            "user32\RedrawWindow", "ptr", cpRow.Hwnd,
            "ptr", 0, "ptr", 0, "uint", 0x0001 | 0x0004 | 0x0100
        )
    if cpPopupState.Has("disabledRows") {
        for cpRow in cpPopupState["disabledRows"]
            try DllCall(
                "user32\RedrawWindow", "ptr", cpRow.Hwnd,
                "ptr", 0, "ptr", 0, "uint", 0x0001 | 0x0004 | 0x0100
            )
    }
}

CPThemedChoicePopupPaintFocus(cpPopupState, cpFocusIndex) {
    cpColors := cpPopupState["colors"]
    cpPreviousFocusIndex := cpPopupState.Get("focusIndex", 0)
    cpPopupState["focusIndex"] := cpFocusIndex
    for cpRowIndex, cpRow in cpPopupState["rows"] {
        if (cpRowIndex != cpPreviousFocusIndex && cpRowIndex != cpFocusIndex)
            continue
        cpRowBack := cpRowIndex = cpFocusIndex
            ? cpColors.Get("accentFocus", cpColors["focus"])
            : cpColors["surface"]
        cpRowText := cpRowIndex = cpFocusIndex
            ? cpColors.Get("accentText", cpColors["text"])
            : cpColors["text"]
        try cpRow.Opt("+Background" cpRowBack " c" cpRowText)
        try DllCall(
            "user32\RedrawWindow", "ptr", cpRow.Hwnd,
            "ptr", 0, "ptr", 0, "uint", 0x0001 | 0x0004 | 0x0100
        ) ; RDW_INVALIDATE | RDW_ERASE | RDW_UPDATENOW
    }
}

CPThemedChoicePopupFocus(cpPopupState, cpFocusIndex) {
    cpRowCount := cpPopupState["rows"].Length
    if !cpRowCount
        return
    if (cpFocusIndex < 1)
        cpFocusIndex := cpRowCount
    else if (cpFocusIndex > cpRowCount)
        cpFocusIndex := 1
    CPThemedChoicePopupPaintFocus(cpPopupState, cpFocusIndex)
    try cpPopupState["rows"][cpFocusIndex].Focus()
}

CPThemedChoicePopupOnKeyDown(wParam, lParam, msg, hwnd) {
    cpRootHwnd := DllCall("user32\GetAncestor", "ptr", hwnd, "uint", 2, "ptr")
    cpRegistry := CPThemedChoicePopupRegistry()
    if !cpRootHwnd || !cpRegistry.Has(cpRootHwnd)
        return
    cpPopupState := cpRegistry[cpRootHwnd]
    if cpPopupState["closed"]
        return
    switch wParam {
        case 0x26, 0x25: ; Up / Left
            CPThemedChoicePopupFocus(
                cpPopupState, cpPopupState["focusIndex"] - 1
            )
            return true
        case 0x28, 0x27: ; Down / Right
            CPThemedChoicePopupFocus(
                cpPopupState, cpPopupState["focusIndex"] + 1
            )
            return true
        case 0x0D, 0x20: ; Enter / Space
            cpPopupResult := cpPopupState.Has("resultValues")
                ? cpPopupState["resultValues"][cpPopupState["focusIndex"]]
                : cpPopupState["focusIndex"]
            CPThemedChoicePopupFinish(
                cpPopupState, cpPopupState["gui"],
                cpPopupResult
            )
            return true
    }
}

CPThemedChoicePopupMouseMove(wParam, lParam, msg, hwnd) {
    rows := CPThemedChoicePopupRowRegistry()
    if !rows.Has(hwnd)
        return
    row := rows[hwnd], s := row["state"]
    if s.Get("modern", false) && !s["closed"] && row["enabled"] && row["index"] != s["focusIndex"]
        CPThemedChoicePopupFocus(s, row["index"])
}

CPThemedChoicePopupRegister(cpPopupState) {
    static cpKeyHandlerRegistered := false
    if !cpKeyHandlerRegistered {
        OnMessage(0x0100, CPThemedChoicePopupOnKeyDown) ; WM_KEYDOWN
        OnMessage(0x0200, CPThemedChoicePopupMouseMove) ; WM_MOUSEMOVE
        cpKeyHandlerRegistered := true
    }
    cpPopupHwnd := cpPopupState["gui"].Hwnd
    cpPopupState["hwnd"] := cpPopupHwnd
    cpColors := cpPopupState["colors"]
    cpPopupState["surfaceBrush"] := DllCall(
        "gdi32\CreateSolidBrush", "uint", CPColorRef(cpColors["surface"]), "ptr"
    )
    cpPopupState["focusBrush"] := DllCall(
        "gdi32\CreateSolidBrush", "uint",
        CPColorRef(cpColors.Get("accentFocus", cpColors["focus"])), "ptr"
    )
    cpPopupState["rowHwnds"] := []
    cpRowRegistry := CPThemedChoicePopupRowRegistry()
    for cpRowIndex, cpRow in cpPopupState["rows"] {
        cpRowHwnd := cpRow.Hwnd
        cpPopupState["rowHwnds"].Push(cpRowHwnd)
        cpRowRegistry[cpRowHwnd] := Map(
            "state", cpPopupState,
            "index", cpRowIndex,
            "enabled", true
        )
    }
    if cpPopupState.Has("disabledRows") {
        for cpRow in cpPopupState["disabledRows"] {
            cpRowHwnd := cpRow.Hwnd
            cpPopupState["rowHwnds"].Push(cpRowHwnd)
            cpRowRegistry[cpRowHwnd] := Map(
                "state", cpPopupState,
                "index", 0,
                "enabled", false
            )
        }
    }
    CPThemedChoicePopupRegistry()[cpPopupHwnd] := cpPopupState
}

CPThemedChoicePopupUnregister(cpPopupState) {
    cpRegistry := CPThemedChoicePopupRegistry()
    try {
        cpPopupHwnd := cpPopupState.Get("hwnd", 0)
        if !cpPopupHwnd
            cpPopupHwnd := cpPopupState["gui"].Hwnd
        if cpRegistry.Has(cpPopupHwnd)
            cpRegistry.Delete(cpPopupHwnd)
    }
    cpRowRegistry := CPThemedChoicePopupRowRegistry()
    if cpPopupState.Has("rowHwnds") {
        for cpRowHwnd in cpPopupState["rowHwnds"] {
            if cpRowRegistry.Has(cpRowHwnd)
                cpRowRegistry.Delete(cpRowHwnd)
        }
    }
    for cpBrushKey in ["surfaceBrush", "focusBrush"] {
        cpBrushHwnd := cpPopupState.Get(cpBrushKey, 0)
        if cpBrushHwnd {
            try DllCall("gdi32\DeleteObject", "ptr", cpBrushHwnd)
            cpPopupState[cpBrushKey] := 0
        }
    }
}

CPThemedChoicePopupWatch(cpPopupState, cpPopupHwnd, cpPopup, *) {
    if cpPopupState["closed"]
        return
    if !DllCall("user32\IsWindow", "ptr", cpPopupHwnd, "int")
        return CPThemedChoicePopupFinish(cpPopupState, cpPopup, 0)
    if !WinActive("ahk_id " cpPopupHwnd)
        CPThemedChoicePopupFinish(cpPopupState, cpPopup, 0)
}

CPThemedChoicePopup(ownerHwnd, anchorHwnd, choices) {
    global controlDarkMode
    if !choices.Length
        return 0

    if CPDialogPresentation(ownerHwnd) = "fullscreen" {
        items := []
        for choice in choices
            items.Push(Map("label", choice))
        title := "Actions"
        try title := Trim(RegExReplace(GuiCtrlFromHwnd(anchorHwnd).Text, "[.…]+$", ""))
        return CPFullscreenMenu(ownerHwnd, items, title != "" ? title : "Actions")
    }

    ; @SHARED_CHOICE_POPUP_CONTROLS_BEGIN@
    cpOwnerValid := ownerHwnd
        && DllCall("user32\IsWindow", "ptr", ownerHwnd, "int")
    cpPopupState := Map("closed", false, "result", 0)
    cpOptions := "+ToolWindow -Caption +Border +AlwaysOnTop"
    if cpOwnerValid
        cpOptions .= " +Owner" ownerHwnd
    cpPopup := Gui(cpOptions)
    cpModern := CPDialogPresentation(ownerHwnd) = "desktop"
    cpPopup.MarginX := cpModern ? 8 : 3
    cpPopup.MarginY := cpModern ? 8 : 3
    cpColors := CPDialogPopupColors(ownerHwnd)
    cpPopup.BackColor := cpColors["window"]
    cpPopup.SetFont((cpModern ? "s11" : "s10") " c" cpColors["text"], "Segoe UI")
    cpPopupState["gui"] := cpPopup
    cpPopupState["colors"] := cpColors
    cpPopupState["rows"] := []
    cpPopupState["focusIndex"] := 1
    cpPopupState["modern"] := cpModern
    cpLongestLabel := 0
    for cpChoiceText in choices
        cpLongestLabel := Max(cpLongestLabel, StrLen(cpChoiceText))
    cpMenuWidth := cpModern ? Max(280, Min(540, 36 + cpLongestLabel * 9)) : 250
    for cpChoiceIndex, cpChoiceText in choices {
        cpPosition := cpChoiceIndex = 1 ? "xm ym" : "xm y+1"
        cpChoiceRow := cpPopup.Add(
            "Text",
            cpPosition " w" cpMenuWidth (cpModern ? " h40 0x380 +Tabstop" : " h30 0x300 +Tabstop Border")
                . " Background" cpColors["surface"]
                . " c" cpColors["text"],
            "  " cpChoiceText
        )
        cpChoiceRow.OnEvent(
            "Click", CPThemedChoicePopupFinish.Bind(
                cpPopupState, cpPopup, cpChoiceIndex
            )
        )
        cpPopupState["rows"].Push(cpChoiceRow)
    }
    cpPopup.OnEvent(
        "Escape", CPThemedChoicePopupFinish.Bind(cpPopupState, cpPopup, 0)
    )
    cpPopup.OnEvent(
        "Close", CPThemedChoicePopupFinish.Bind(cpPopupState, cpPopup, 0)
    )
    ; @SHARED_CHOICE_POPUP_CONTROLS_END@

    cpPopup.Show("Hide AutoSize")
    CPApplyOwnedDialogTheme(cpPopup)
    CPDialogPopupFinishLayout(cpPopupState)
    ; CPApplyOwnedDialogTheme uses the normal window background for generic
    ; text controls. Restore the menu-row surfaces afterward.
    CPThemedChoicePopupResetRows(cpPopupState)
    CPThemedChoicePopupPaintFocus(cpPopupState, 1)
    cpPopup.GetPos(,, &cpPopupW, &cpPopupH)
    cpAnchorRect := Buffer(16, 0)
    if !(anchorHwnd && DllCall(
        "user32\GetWindowRect", "ptr", anchorHwnd,
        "ptr", cpAnchorRect.Ptr, "int"
    )) {
        CoordMode("Mouse", "Screen")
        MouseGetPos(&cpX, &cpY)
        cpAnchorTop := cpY
    } else {
        cpAnchorLeft := NumGet(cpAnchorRect, 0, "int")
        cpAnchorTop := NumGet(cpAnchorRect, 4, "int")
        cpAnchorRight := NumGet(cpAnchorRect, 8, "int")
        cpAnchorBottom := NumGet(cpAnchorRect, 12, "int")
        cpX := cpAnchorRight - cpPopupW
        cpY := cpAnchorBottom
    }
    cpVirtualX := SysGet(76), cpVirtualY := SysGet(77)
    cpVirtualW := SysGet(78), cpVirtualH := SysGet(79)
    cpX := Max(cpVirtualX, Min(cpX, cpVirtualX + cpVirtualW - cpPopupW))
    if (cpY + cpPopupH > cpVirtualY + cpVirtualH)
        cpY := Max(cpVirtualY, cpAnchorTop - cpPopupH)
    if cpModern
        CPDialogClampPopup(&cpX, &cpY, cpPopupW, cpPopupH, cpAnchorTop, anchorHwnd ? anchorHwnd : ownerHwnd)
    cpPopup.Show("x" cpX " y" cpY)
    CPThemedChoicePopupRegister(cpPopupState)
    ; Register first, then repaint every row once while visible so WM_CTLCOLOR
    ; supplies the popup brushes instead of the generic dialog background.
    CPThemedChoicePopupResetRows(cpPopupState)
    CPThemedChoicePopupFocus(cpPopupState, 1)
    try WinActivate("ahk_id " cpPopup.Hwnd)
    cpWatch := CPThemedChoicePopupWatch.Bind(
        cpPopupState, cpPopup.Hwnd, cpPopup
    )
    SetTimer(cpWatch, 80)
    try {
        while !cpPopupState["closed"]
            Sleep(20)
    } finally {
        SetTimer(cpWatch, 0)
        CPThemedChoicePopupUnregister(cpPopupState)
        try cpPopup.Destroy()
    }
    return cpPopupState["result"]
}

CPThemedContextPopup(ownerHwnd, clientX, clientY, items) {
    global controlDarkMode
    if !items.Length
        return 0
    if CPDialogPresentation(ownerHwnd) = "fullscreen"
        return CPFullscreenMenu(ownerHwnd, items)

    ; @SHARED_CONTEXT_POPUP_CONTROLS_BEGIN@
    cpOwnerValid := ownerHwnd
        && DllCall("user32\IsWindow", "ptr", ownerHwnd, "int")
    cpPopupState := Map(
        "closed", false,
        "result", 0,
        "rows", [],
        "resultValues", [],
        "disabledRows", [],
        "separators", [],
        "focusIndex", 1
    )
    cpOptions := "+ToolWindow -Caption +Border +AlwaysOnTop"
    if cpOwnerValid
        cpOptions .= " +Owner" ownerHwnd
    cpPopup := Gui(cpOptions)
    cpModern := CPDialogPresentation(ownerHwnd) = "desktop"
    cpPopup.MarginX := cpModern ? 8 : 4
    cpPopup.MarginY := cpModern ? 8 : 4
    cpPopup.SetFont(cpModern ? "s11" : "s9", "Segoe UI")
    cpColors := CPDialogPopupColors(ownerHwnd)
    cpPopup.BackColor := cpColors["surface"]
    cpPopupState["gui"] := cpPopup
    cpPopupState["colors"] := cpColors
    cpPopupState["modern"] := cpModern

    cpLongestLabel := 0
    for cpItem in items {
        if cpItem.Has("label")
            cpLongestLabel := Max(cpLongestLabel, StrLen(cpItem["label"]))
    }
    cpMenuWidth := cpModern ? Max(280, Min(540, 36 + cpLongestLabel * 9)) : Max(220, Min(390, 42 + cpLongestLabel * 8))
    cpHasPreviousRow := false
    for cpItemIndex, cpItem in items {
        if (cpItem.Has("separator") && cpItem["separator"]) {
            cpSeparatorPosition := cpHasPreviousRow ? "xm y+4" : "xm ym"
            cpSeparator := cpPopup.Add(
                "Text",
                cpSeparatorPosition " w" cpMenuWidth " h1"
                    . " Background" cpColors["border"]
            )
            cpPopupState["separators"].Push(cpSeparator)
            cpHasPreviousRow := false
            continue
        }
        if !cpItem.Has("label")
            continue
        cpEnabled := !cpItem.Has("enabled") || cpItem["enabled"]
        cpPosition := cpHasPreviousRow ? "xm y+1" : "xm y+4"
        cpRowOptions := cpPosition " w" cpMenuWidth (cpModern ? " h40 0x280" : " h29 0x200")
            . " Background" cpColors["surface"]
            . " c" (cpEnabled ? cpColors["text"] : cpColors["muted"])
        if cpEnabled
            cpRowOptions .= " +Tabstop"
        cpChoiceRow := cpPopup.Add(
            "Text", cpRowOptions, "  " cpItem["label"]
        )
        if cpEnabled {
            cpPopupState["rows"].Push(cpChoiceRow)
            cpPopupState["resultValues"].Push(cpItemIndex)
            cpChoiceRow.OnEvent(
                "Click", CPThemedChoicePopupFinish.Bind(
                    cpPopupState, cpPopup, cpItemIndex
                )
            )
        } else
            cpPopupState["disabledRows"].Push(cpChoiceRow)
        cpHasPreviousRow := true
    }
    if !cpPopupState["rows"].Length {
        cpPopup.Destroy()
        return 0
    }

    cpPopup.OnEvent(
        "Escape", CPThemedChoicePopupFinish.Bind(cpPopupState, cpPopup, 0)
    )
    cpPopup.OnEvent(
        "Close", CPThemedChoicePopupFinish.Bind(cpPopupState, cpPopup, 0)
    )
    ; @SHARED_CONTEXT_POPUP_CONTROLS_END@
    cpPopup.Show("Hide AutoSize")
    CPApplyOwnedDialogTheme(cpPopup)
    CPDialogPopupFinishLayout(cpPopupState)
    CPThemedChoicePopupResetRows(cpPopupState)
    for cpSeparator in cpPopupState["separators"]
        try cpSeparator.Opt("+Background" cpColors["border"])
    CPThemedChoicePopupPaintFocus(cpPopupState, 1)
    cpPopup.GetPos(,, &cpPopupW, &cpPopupH)

    cpScreenPoint := Buffer(8, 0)
    NumPut("int", clientX, "int", clientY, cpScreenPoint, 0)
    if cpOwnerValid
        try DllCall(
            "user32\ClientToScreen", "ptr", ownerHwnd,
            "ptr", cpScreenPoint.Ptr, "int"
        )
    cpX := NumGet(cpScreenPoint, 0, "int")
    cpY := NumGet(cpScreenPoint, 4, "int")
    cpVirtualX := SysGet(76), cpVirtualY := SysGet(77)
    cpVirtualW := SysGet(78), cpVirtualH := SysGet(79)
    cpX := Max(cpVirtualX, Min(cpX, cpVirtualX + cpVirtualW - cpPopupW))
    cpY := Max(cpVirtualY, Min(cpY, cpVirtualY + cpVirtualH - cpPopupH))
    if cpModern
        CPDialogClampPopup(&cpX, &cpY, cpPopupW, cpPopupH, cpY)

    cpPopup.Show("x" cpX " y" cpY)
    CPThemedChoicePopupRegister(cpPopupState)
    CPThemedChoicePopupResetRows(cpPopupState)
    CPThemedChoicePopupFocus(cpPopupState, 1)
    try WinActivate("ahk_id " cpPopup.Hwnd)
    cpWatch := CPThemedChoicePopupWatch.Bind(
        cpPopupState, cpPopup.Hwnd, cpPopup
    )
    SetTimer(cpWatch, 80)
    try {
        while !cpPopupState["closed"]
            Sleep(20)
    } finally {
        SetTimer(cpWatch, 0)
        CPThemedChoicePopupUnregister(cpPopupState)
        try cpPopup.Destroy()
    }
    return cpPopupState["result"]
}

CPDialogDefaultOwner() {
    global ui, CPBigBoxGui
    ; An owned editor can be active while the main desktop is hidden. Only
    ; attach to this script's known UI, never another application's window.
    active := DllCall("user32\GetForegroundWindow", "ptr")
    if active && CPDialogPresentation(active) != "classic"
        return active
    try {
        if CPBigBoxDashboardVisible() && !DllCall("user32\IsWindowVisible", "ptr", ui.Hwnd)
            return CPBigBoxGui.Hwnd
    }
    return ui.Hwnd
}

CPInputDialogCreate(owner, promptText, title, infoText := "", value := "") {
    bigBox := CPDialogPresentation(owner) = "fullscreen"
    g := Gui("+Owner" owner " +OwnDialogs +AlwaysOnTop"
        . (bigBox ? " -Caption +ToolWindow -DPIScale" : ""), title)
    g.MarginX := 0, g.MarginY := 0
    g.SetFont("s11", "Segoe UI")
    s := Map("gui", g, "owner", owner, "closed", false, "bigBoxPresentation", bigBox,
        "result", {Result: "Cancel", Value: ""})
    g.CPInputDialog := s
    g.StudyPreserveEditSelection := true
    ; Build fullscreen background/focus surfaces first so native controls sit
    ; above them in child-window z-order, as in the other fullscreen forms.
    if bigBox {
        parent := Map("gui", GuiFromHwnd(owner), "bigBoxPresentation", true)
        s["bigBoxForm"] := StudyLibraryBigBoxFormState(g, parent, title, "Enter a value, then confirm or cancel.", StudyLibraryConfiguredName())
    }
    c := Map(), s["controls"] := c
    c["prompt"] := g.AddText("x40 y194 w600 h48 +0x80", promptText)
    c["editor"] := g.AddEdit("x40 y256 w600 h36", value)
    c["info"] := g.AddText("x40 y314 w600 h90 +0x80", infoText)
    c["save"] := g.AddButton("x420 y434 w120 h34 Default", "OK")
    c["cancel"] := g.AddButton("x552 y434 w120 h34", "Cancel")
    c["save"].OnEvent("Click", CPInputDialogClose.Bind(s, true))
    c["cancel"].OnEvent("Click", CPInputDialogClose.Bind(s, false))
    g.OnEvent("Escape", CPInputDialogClose.Bind(s, false))
    g.OnEvent("Close", CPInputDialogClose.Bind(s, false))
    if bigBox {
        f := s["bigBoxForm"]
        f["shell"]["footer"].Text := "D-pad  Navigate     A / Cross  Select     Keyboard  Enter text     B / Circle / Esc  Cancel"
        StudyLibraryBigBoxFormAdd(f, "prompt", c["prompt"], 0, 0, 1000, 130)
        StudyLibraryBigBoxFormAdd(f, "editor", c["editor"], 0, 155, 1000, 100, "editor")
        StudyLibraryBigBoxFormAdd(f, "info", c["info"], 0, 305, 1000, 280)
        StudyLibraryBigBoxFormAdd(f, "save", c["save"], 620, 840, 180, 110, "button")
        StudyLibraryBigBoxFormAdd(f, "cancel", c["cancel"], 820, 840, 180, 110, "button")
    } else {
        s["addButton"] := c["save"]
        CPRegisterMutedControl(c["info"])
        StudyDesktopDialogCreate(s, "input", title, "Enter a value, then confirm or cancel.", 680, 500)
        c["prompt"].SetFont("s12 Bold")
        for key in ["save", "cancel"]
            StudyDesktopDialogFooter(s, c[key])
        StudyDesktopTheme(s["desktop"])
    }
    return s
}

CPInputDialogLayout(s, w, h) {
    c := s["controls"]
    s["desktop"]["panels"].Push([24, 174, w - 48, h - 260, "panel"])
    c["prompt"].Move(40, 194, w - 80, 48)
    c["editor"].Move(40, 256, w - 80, 36)
    c["info"].Move(40, 314, w - 80, h - 416)
    c["save"].Move(w - 276, h - 50, 120, 34)
    c["cancel"].Move(w - 144, h - 50, 120, 34)
}

CPInputDialogClose(s, accept := false, *) {
    if s["closed"]
        return
    if accept
        s["result"] := {Result: "OK", Value: s["controls"]["editor"].Value}
    s["closed"] := true
    if s.Has("bigBoxForm") {
        s["bigBoxForm"]["closed"] := true
        StudyBigBoxFocusFrameStop(s["bigBoxForm"])
    }
    try s["gui"].Destroy()
}

CPInputDialogRun(s, width := 760) {
    owner := s["owner"], enabled := DllCall("user32\IsWindowEnabled", "ptr", owner)
    previousFocus := StudyControllerFocusedHwnd(owner)
    try {
        DllCall("user32\EnableWindow", "ptr", owner, "int", 0)
        if s["bigBoxPresentation"]
            StudyLibraryBigBoxFormShow(s["bigBoxForm"], s["controls"]["editor"])
        else
            StudyDesktopDialogShow(s, Max(680, Min(1000, width)), 520, s["controls"]["editor"])
        s["ready"] := true
        while !s["closed"] && DllCall("user32\IsWindow", "ptr", owner)
            Sleep(25)
    } finally {
        CPInputDialogClose(s)
        if DllCall("user32\IsWindow", "ptr", owner) {
            DllCall("user32\EnableWindow", "ptr", owner, "int", enabled)
            if enabled {
                try WinActivate("ahk_id " owner)
                if previousFocus && CPHwndIsFocusable(previousFocus)
                    try StudyControllerSetFocus(owner, previousFocus)
            }
        }
        CPControllerResetNavigation()
    }
    return s["result"]
}

CPThemedInputBox(promptText, dialogTitle, infoText := "", initialValue := ""
    , dialogWidth := 420, ownerHwnd := 0) {
    global ui
    result := {Result: "Cancel", Value: ""}
    closed := false
    contentWidth := Max(280, dialogWidth - 32)

    inputOwner := ownerHwnd
    if !(inputOwner && DllCall("user32\IsWindow", "ptr", inputOwner, "int"))
        inputOwner := CPDialogDefaultOwner()
    if CPDialogPresentation(inputOwner) != "classic"
        return CPInputDialogRun(CPInputDialogCreate(inputOwner, promptText, dialogTitle, infoText, initialValue), dialogWidth + 240)
    dlg := Gui("+Owner" inputOwner " +AlwaysOnTop", dialogTitle)
    dlg.MarginX := 16
    dlg.MarginY := 14
    dlg.Add("Text", "xm w" contentWidth, promptText)
    if (infoText != "")
        dlg.Add("Text", "xm y+8 w" contentWidth, infoText)
    editor := dlg.Add("Edit", "xm y+12 w" contentWidth, initialValue)
    btnOK := dlg.Add("Button", "xm y+14 w120 Default", "OK")
    btnCancel := dlg.Add("Button", "x+10 yp w120", "Cancel")

    btnOK.OnEvent("Click", (*) => (
        result.Result := "OK",
        result.Value := editor.Value,
        closed := true,
        dlg.Destroy()
    ))
    btnCancel.OnEvent("Click", (*) => (closed := true, dlg.Destroy()))
    dlg.OnEvent("Escape", (*) => (closed := true, dlg.Destroy()))
    dlg.OnEvent("Close", (*) => (closed := true))

    dlg.Show("AutoSize Center")
    CPApplyOwnedDialogTheme(dlg)
    try editor.Focus()
    while !closed
        Sleep(30)
    return result
}

CPTextEditorClose(dlg, *) {
    try dlg.Destroy()
}

CPShowTextEditorDialog(dlg, editorCtrl, ownerHwnd := 0) {
    global ui
    ; Ownership lets the controller-navigation poll recognize this editor as
    ; part of the control-panel workflow. B / Circle is dispatched as Escape,
    ; which uses the same close path as the editor's Close button.
    editorOwner := ownerHwnd
    if !(editorOwner && DllCall("user32\IsWindow", "ptr", editorOwner, "int"))
        editorOwner := ui.Hwnd
    try dlg.Opt("+Owner" editorOwner)
    dlg.OnEvent("Escape", CPTextEditorClose.Bind(dlg))
    dlg.Show()
    CPApplyOwnedDialogTheme(dlg)

    ; Keep the editor ready for typing without selecting all existing text.
    try editorCtrl.Focus()
    try SendMessage(0x00B1, 0, 0, editorCtrl.Hwnd) ; EM_SETSEL
    try SendMessage(0x00B7, 0, 0, editorCtrl.Hwnd) ; EM_SCROLLCARET
}

AddModelDialogSelect(which, rbOnline, rbManual, focusChoice := true, *) {
    chooseOnline := (which = "online")
    rbOnline.Value := chooseOnline ? 1 : 0
    rbManual.Value := chooseOnline ? 0 : 1
    if focusChoice
        (chooseOnline ? rbOnline : rbManual).Focus()
}

AddModelDialogNavigate(direction, rbOnline, rbManual, btnContinue, btnCancel, *) {
    focusHwnd := DllCall("user32\GetFocus", "ptr")
    if (focusHwnd = rbOnline.Hwnd) {
        if (direction = "Down" || direction = "Right")
            rbManual.Focus()
        return
    }
    if (focusHwnd = rbManual.Hwnd) {
        if (direction = "Up" || direction = "Left")
            rbOnline.Focus()
        else if (direction = "Down")
            btnContinue.Focus()
        return
    }
    if (focusHwnd = btnContinue.Hwnd) {
        if (direction = "Up")
            rbManual.Focus()
        else if (direction = "Right")
            btnCancel.Focus()
        return
    }
    if (focusHwnd = btnCancel.Hwnd) {
        if (direction = "Up")
            rbManual.Focus()
        else if (direction = "Left")
            btnContinue.Focus()
        return
    }
    (rbOnline.Value ? rbOnline : rbManual).Focus()
}

AddModelDialogActivate(rbOnline, rbManual, btnContinue, btnCancel, *) {
    focusHwnd := DllCall("user32\GetFocus", "ptr")
    if (focusHwnd = rbOnline.Hwnd) {
        AddModelDialogSelect("online", rbOnline, rbManual)
        return
    }
    if (focusHwnd = rbManual.Hwnd) {
        AddModelDialogSelect("manual", rbOnline, rbManual)
        return
    }
    if (focusHwnd = btnCancel.Hwnd)
        SendMessage(0x00F5, 0, 0, btnCancel.Hwnd) ; BM_CLICK
    else
        SendMessage(0x00F5, 0, 0, btnContinue.Hwnd)
}

CPApplyDialogRadioTheme(radioCtrl) {
    global controlDarkMode
    colors := CPPalette(controlDarkMode)
    try radioCtrl.SetFont("c" colors["text"])
    if controlDarkMode {
